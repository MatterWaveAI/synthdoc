{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "layout.schema.json",
  "title": "Layer 4: Layout",
  "description": "Physical arrangement and flow of content on the page",
  "definitions": {
    "Layout": {
      "type": "object",
      "properties": {
        "page": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "enum": ["letter", "legal", "a4", "a3", "custom"],
              "default": "letter"
            },
            "width": { "type": "number", "description": "Width in points (1/72 inch)" },
            "height": { "type": "number" },
            "orientation": {
              "type": "string",
              "enum": ["portrait", "landscape"]
            },
            "margins": {
              "type": "object",
              "properties": {
                "top": { "type": "number" },
                "right": { "type": "number" },
                "bottom": { "type": "number" },
                "left": { "type": "number" }
              }
            }
          }
        },
        "columns": {
          "type": "object",
          "properties": {
            "count": { "type": "integer", "minimum": 1, "maximum": 12 },
            "gutter": { "type": "number", "description": "Space between columns in points" },
            "widths": {
              "type": "array",
              "items": { "type": "number" },
              "description": "Relative column widths (percentages summing to 100)"
            }
          }
        },
        "grid": {
          "type": "object",
          "properties": {
            "rows": { "type": "integer" },
            "columns": { "type": "integer" },
            "cell_spacing": { "type": "number" }
          }
        },
        "flow": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["sequential", "columnar", "grid", "absolute", "free-form"]
            },
            "direction": {
              "type": "string",
              "enum": ["ltr", "rtl", "ttb", "btt"]
            },
            "alignment": {
              "type": "string",
              "enum": ["left", "center", "right", "justify"]
            },
            "spacing": {
              "type": "object",
              "properties": {
                "line_height": { "type": "number" },
                "paragraph_spacing": { "type": "number" },
                "section_spacing": { "type": "number" }
              }
            }
          }
        },
        "background": {
          "type": "object",
          "properties": {
            "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "image": { "type": "string", "format": "uri" },
            "texture": {
              "type": "string",
              "enum": ["none", "paper", "parchment", "watermark"]
            }
          }
        }
      }
    }
  }
}
